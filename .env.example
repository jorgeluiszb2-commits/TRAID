# Supabase — configuración local de TRAID
# 1. Copia este archivo como `.env.local` (nunca se sube a Git; está ignorado).
# 2. Rellena los valores en tu Supabase Dashboard → Project Settings → API.
# 3. Nunca compartas valores reales en chat, issues, commits o PRs.
# 4. En Vercel, configura las mismas variables en el panel del proyecto.

# URL pública del proyecto (Settings -> API -> Project URL).
NEXT_PUBLIC_SUPABASE_URL=

# Clave publicable: "publishable" en proyectos nuevos (o "anon" en legacy).
# Es la ÚNICA clave que puede ir al navegador; las RLS la protegen.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Alternativa legacy si tu proyecto solo muestra la clave anon:
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# CLAVE DE SERVICIO "service_role": SOLO para código de servidor.
# NUNCA la expongas en el navegador ni la subas al repositorio.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: URL pública del sitio (enlaces de auth, metadatos).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
