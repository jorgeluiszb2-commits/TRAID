# Copia este archivo como .env.local y rellena los valores de tu proyecto Supabase.
# Nunca subas .env.local ni valores reales de claves al repositorio.

# URL pública del proyecto de Supabase (Settings -> API -> Project URL).
NEXT_PUBLIC_SUPABASE_URL=

# Clave publicable "anon" (se puede exponer en el navegador; la protegen las RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio "service_role". SOLO para código de servidor.
# Nunca la expongas en el navegador ni la subas al repositorio.
SUPABASE_SERVICE_ROLE_KEY=
